---
import Layout from "../layouts/Layout.astro";

import { getI18n } from "../i18n";
const { currentLocale = "en" } = Astro;

const { ABOUT, CHANGE_LANGUAGE, CURSOS, NOMBRE, PROYECTS, SUBTITLE, CV_LINK } =
  getI18n({
    currentLocale,
  });
---

<Layout lang={currentLocale} title="Sebastian Diaz Portfolio">
  <main class="p-4 m-auto my-4 max-w-[1280px]">Empezando rewrite</main>
</Layout>

<style>
  html {
    scroll-behavior: smooth;
    box-sizing: border-box;
  }
</style>
